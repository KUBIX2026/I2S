        <mxCell id="c71" parent="1" style="shape=note;size=10;backgroundOutline=1;html=1;whiteSpace=nowrap;fillColor=#fffbe3;strokeColor=#b9a24a;strokeWidth=1.3;verticalAlign=middle;align=left;spacingLeft=12;spacing=0;spacingTop=0;spacingBottom=0;spacingRight=0;fontFamily=Inter,Helvetica,Arial,sans-serif;fontSize=11;fontColor=#444444;fontStyle=0;" value="&lt;span style=&quot;font-family: Inter, Helvetica, Arial, sans-serif; font-size: 11px; color: #333333; font-weight: bold; font-style: normal;&quot;&gt;Tiempos (en ciclos de clk)&lt;/span&gt;&lt;br&gt;bclk = 0 durante ⌊DIV/2⌋&lt;br&gt;bclk = 1 durante DIV − ⌊DIV/2⌋&lt;br&gt;1 bit = DIV; &amp;nbsp;1 trama = 32 bits = 32·DIV&lt;br&gt;1 trama = 1 muestra en L y en R = 1/FS_REAL&lt;br&gt;en solo se revisa con slot = 31:&lt;br&gt;una trama nunca se corta a la mitad." vertex="1">
          <mxGeometry height="117" width="308" x="1536" y="297" as="geometry" />
        </mxCell>
        <mxCell id="c72" parent="1" style="shape=note;size=10;backgroundOutline=1;html=1;whiteSpace=nowrap;fillColor=#fffbe3;strokeColor=#b9a24a;strokeWidth=1.3;verticalAlign=middle;align=left;spacingLeft=12;spacing=0;spacingTop=0;spacingBottom=0;spacingRight=0;fontFamily=DejaVu Sans Mono,JetBrains Mono,Consolas,monospace;fontSize=11;fontColor=#333333;fontStyle=0;" value="&lt;span style=&quot;font-family: Inter, Helvetica, Arial, sans-serif; font-size: 11px; color: #333333; font-weight: bold; font-style: normal;&quot;&gt;Salidas registradas&lt;/span&gt;&lt;br&gt;i2s_bclk &amp;nbsp;← bclk&lt;br&gt;i2s_lrclk ← lr &amp;amp; run&lt;br&gt;i2s_sd &amp;nbsp;&amp;nbsp;&amp;nbsp;← q[31] &amp;amp; run&lt;br&gt;&lt;span style=&quot;font-family: Inter, Helvetica, Arial, sans-serif; font-size: 11px; color: #444444; font-weight: normal; font-style: normal;&quot;&gt;Las tres salen de flip-flops: mismo&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family: Inter, Helvetica, Arial, sans-serif; font-size: 11px; color: #444444; font-weight: normal; font-style: normal;&quot;&gt;retardo de 1 ciclo, sin glitches.&lt;/span&gt;" vertex="1">
          <mxGeometry height="102" width="308" x="1536" y="436" as="geometry" />
        </mxCell>
        <mxCell id="c73" parent="1" style="shape=note;size=10;backgroundOutline=1;html=1;whiteSpace=nowrap;fillColor=#f5f5f5;strokeColor=#8a8a8a;strokeWidth=1.3;verticalAlign=middle;align=left;spacingLeft=12;spacing=0;spacingTop=0;spacingBottom=0;spacingRight=0;fontFamily=DejaVu Sans Mono,JetBrains Mono,Consolas,monospace;fontSize=11;fontColor=#333333;fontStyle=0;" value="&lt;span style=&quot;font-family: Inter, Helvetica, Arial, sans-serif; font-size: 11px; color: #333333; font-weight: bold; font-style: normal;&quot;&gt;PARÁMETROS&lt;/span&gt;&lt;br&gt;FCIA_FPGA = frecuencia de clk (por definir)&lt;br&gt;FS_AUDIO &amp;nbsp;= 44 100 Hz&lt;br&gt;PROF_FIFO = 1024 &amp;nbsp;(AW = 10 bits)&lt;br&gt;DIV_RESET = (FCIA_FPGA + 16·FS_AUDIO)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;/ (32·FS_AUDIO)&lt;br&gt;DIV_MIN &amp;nbsp;&amp;nbsp;= 4&lt;br&gt;f_BCLK &amp;nbsp;&amp;nbsp;&amp;nbsp;= FCIA_FPGA / DIV&lt;br&gt;FS_REAL &amp;nbsp;&amp;nbsp;= FCIA_FPGA / (32·DIV)" vertex="1">
          <mxGeometry height="147" width="308" x="1536" y="560" as="geometry" />
        </mxCell>
        <mxCell id="c74" parent="1" style="text;html=1;align=left;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;spacingRight=0;spacingLeft=0;strokeColor=none;fillColor=none;fontFamily=Inter,Helvetica,Arial,sans-serif;fontSize=24;fontColor=#111111;fontStyle=1;" value="interfaz CSR y transmisor I2S" vertex="1">
