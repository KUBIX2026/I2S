        <mxCell id="c87" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=55;html=1;whiteSpace=nowrap;fillColor=#f8d4d1;strokeColor=#b0473f;strokeWidth=1.3;verticalAlign=middle;align=center;spacingLeft=0;spacing=0;spacingTop=0;spacingBottom=0;spacingRight=0;fontFamily=Inter,Helvetica,Arial,sans-serif;fontSize=11;fontColor=#444444;fontStyle=0;" value="&lt;span style=&quot;font-family: &#39;DejaVu Sans Mono&#39;, &#39;JetBrains Mono&#39;, Consolas, monospace; font-size: 12px; color: #a8322d; font-weight: bold; font-style: normal;&quot;&gt;FALLA&lt;/span&gt;&lt;br&gt;bytes de más&lt;br&gt;o de menos" vertex="1">
