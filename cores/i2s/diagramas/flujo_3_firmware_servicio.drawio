          <mxGeometry height="56" width="104" x="1500" y="722" as="geometry" />
        </mxCell>
        <mxCell id="c86" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=30;html=1;whiteSpace=nowrap;fillColor=#d7ecd9;strokeColor=#4f8f5b;strokeWidth=1.3;verticalAlign=middle;align=center;spacingLeft=0;spacing=0;spacingTop=0;spacingBottom=0;spacingRight=0;fontFamily=Inter,Helvetica,Arial,sans-serif;fontSize=13;fontColor=#111111;fontStyle=1;" value="OK" vertex="1">
