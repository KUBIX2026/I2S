        <mxCell id="c84" parent="1" style="rounded=0;html=1;whiteSpace=nowrap;fillColor=#ffffff;strokeColor=#222222;strokeWidth=1.3;verticalAlign=middle;align=center;spacingLeft=0;spacing=0;spacingTop=0;spacingBottom=0;spacingRight=0;fontFamily=DejaVu Sans Mono,JetBrains Mono,Consolas,monospace;fontSize=12;fontColor=#111111;fontStyle=0;" value="emitir m bytes → dest:&lt;br&gt;w[8m−1:8m−8], …, w[7:0]&lt;br&gt;k ← k + m" vertex="1">
          <mxGeometry height="63" width="190" x="1457" y="633" as="geometry" />
