        <mxCell id="c75" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=40;html=1;whiteSpace=nowrap;fillColor=#f8d4d1;strokeColor=#b0473f;strokeWidth=1.3;verticalAlign=middle;align=center;spacingLeft=0;spacing=0;spacingTop=0;spacingBottom=0;spacingRight=0;fontFamily=DejaVu Sans Mono,JetBrains Mono,Consolas,monospace;fontSize=12;fontColor=#a8322d;fontStyle=1;" value="ERR_VACIO&lt;br&gt;&lt;span style=&quot;font-family: Inter, Helvetica, Arial, sans-serif; font-size: 11px; color: #444444; font-weight: normal; font-style: normal;&quot;&gt;WAV sin muestras&lt;/span&gt;" vertex="1">
          <mxGeometry height="40" width="134" x="1008" y="1844" as="geometry" />
