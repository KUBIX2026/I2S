        <mxCell id="c78" parent="1" style="rounded=0;html=1;whiteSpace=nowrap;fillColor=#ffffff;strokeColor=#222222;strokeWidth=1.3;verticalAlign=middle;align=center;spacingLeft=0;spacing=0;spacingTop=0;spacingBottom=0;spacingRight=0;fontFamily=DejaVu Sans Mono,JetBrains Mono,Consolas,monospace;fontSize=12;fontColor=#111111;fontStyle=0;" value="activa[c] ← 0; &amp;nbsp;pend[c] ← 0&lt;br&gt;&lt;span style=&quot;font-family: &#39;DejaVu Sans Mono&#39;, &#39;JetBrains Mono&#39;, Consolas, monospace; font-size: 12px; color: #1d6b33; font-weight: bold; font-style: normal;&quot;&gt;fin[c] ← 1&lt;/span&gt;" vertex="1">
          <mxGeometry height="47" width="218" x="1311" y="185" as="geometry" />
        </mxCell>
        <mxCell id="c79" parent="1" style="rhombus;html=1;whiteSpace=nowrap;fillColor=#d3effb;strokeColor=#222222;strokeWidth=1.3;verticalAlign=middle;align=center;spacingLeft=0;spacing=0;spacingTop=0;spacingBottom=0;spacingRight=0;fontFamily=DejaVu Sans Mono,JetBrains Mono,Consolas,monospace;fontSize=12;fontColor=#111111;fontStyle=0;" value="¿activa[MUS] = 0&lt;br&gt;y activa[SFX] = 0?" vertex="1">
          <mxGeometry height="88" width="246" x="1297" y="258" as="geometry" />
        </mxCell>
        <mxCell id="c80" parent="1" style="rounded=0;html=1;whiteSpace=nowrap;fillColor=#ffffff;strokeColor=#222222;strokeWidth=1.3;verticalAlign=middle;align=center;spacingLeft=0;spacing=0;spacingTop=0;spacingBottom=0;spacingRight=0;fontFamily=Inter,Helvetica,Arial,sans-serif;fontSize=11;fontColor=#444444;fontStyle=0;" value="&lt;span style=&quot;font-family: &#39;DejaVu Sans Mono&#39;, &#39;JetBrains Mono&#39;, Consolas, monospace; font-size: 12px; color: #1f5fa8; font-weight: normal; font-style: normal;&quot;&gt;CONTROL ← en_sw | FLUSH&lt;/span&gt;&lt;br&gt;descarta lo que quedaba en la FIFO;&lt;br&gt;audio_service() detiene el transmisor" vertex="1">
          <mxGeometry height="59" width="216" x="1312" y="372" as="geometry" />
        </mxCell>
        <mxCell id="c81" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=32;html=1;whiteSpace=nowrap;fillColor=#d7ecd9;strokeColor=#4f8f5b;strokeWidth=1.3;verticalAlign=middle;align=center;spacingLeft=0;spacing=0;spacingTop=0;spacingBottom=0;spacingRight=0;fontFamily=Inter,Helvetica,Arial,sans-serif;fontSize=13;fontColor=#111111;fontStyle=1;" value="Fin" vertex="1">
          <mxGeometry height="32" width="58" x="1391" y="457" as="geometry" />
        </mxCell>
        <mxCell id="c82" parent="1" style="shape=note;size=10;backgroundOutline=1;html=1;whiteSpace=nowrap;fillColor=#f5f5f5;strokeColor=#8a8a8a;strokeWidth=1.3;verticalAlign=middle;align=left;spacingLeft=12;spacing=0;spacingTop=0;spacingBottom=0;spacingRight=0;fontFamily=DejaVu Sans Mono,JetBrains Mono,Consolas,monospace;fontSize=11;fontColor=#333333;fontStyle=0;" value="&lt;span style=&quot;font-family: Inter, Helvetica, Arial, sans-serif; font-size: 11px; color: #333333; font-weight: bold; font-style: normal;&quot;&gt;CONSTANTES&lt;/span&gt;&lt;br&gt;I2S_BASE &amp;nbsp;&amp;nbsp;= 0x0047_0000 (cs8)&lt;br&gt;&amp;nbsp;&amp;nbsp;CONTROL +0x0 &amp;nbsp;STATUS +0x4&lt;br&gt;&amp;nbsp;&amp;nbsp;DATA &amp;nbsp;&amp;nbsp;&amp;nbsp;+0x8 &amp;nbsp;CLKDIV +0xC&lt;br&gt;FLASH_BASE = 0x0042_0000 (cs3, grupo D)&lt;br&gt;AUDIO_BASE, AUDIO_TAM: región de audio&lt;br&gt;&amp;nbsp;&amp;nbsp;en la flash (por definir con el grupo D)&lt;br&gt;NCLIPS_MAX = 64&lt;br&gt;T_MAX &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;= límite de sondeos sin&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;respuesta (p. ej. 100 000)&lt;br&gt;FS_AUDIO &amp;nbsp;&amp;nbsp;= 44 100 Hz&lt;br&gt;DIV_AUDIO &amp;nbsp;= (FCIA_FPGA + 16·FS_AUDIO)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;/ (32·FS_AUDIO)&lt;br&gt;PROF_FIFO &amp;nbsp;= 1024" vertex="1">
          <mxGeometry height="220" width="302" x="1264" y="529" as="geometry" />
        </mxCell>
        <mxCell id="c83" parent="1" style="shape=note;size=10;backgroundOutline=1;html=1;whiteSpace=nowrap;fillColor=#f5f5f5;strokeColor=#8a8a8a;strokeWidth=1.3;verticalAlign=middle;align=left;spacingLeft=12;spacing=0;spacingTop=0;spacingBottom=0;spacingRight=0;fontFamily=DejaVu Sans Mono,JetBrains Mono,Consolas,monospace;fontSize=11;fontColor=#333333;fontStyle=0;" value="&lt;span style=&quot;font-family: Inter, Helvetica, Arial, sans-serif; font-size: 11px; color: #333333; font-weight: bold; font-style: normal;&quot;&gt;VARIABLES&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family: Inter, Helvetica, Arial, sans-serif; font-size: 11px; color: #444444; font-weight: normal; font-style: normal;&quot;&gt;Por canal c ∈ {MUS, SFX}:&lt;/span&gt;&lt;br&gt;ini[c] &amp;nbsp;&amp;nbsp;&amp;nbsp;dirección de la 1.ª muestra&lt;br&gt;dir[c] &amp;nbsp;&amp;nbsp;&amp;nbsp;próxima dirección a leer&lt;br&gt;r[c] &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;muestras que faltan por leer&lt;br&gt;N[c] &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;muestras del WAV&lt;br&gt;loop[c] &amp;nbsp;&amp;nbsp;1 = repetir (MUS)&lt;br&gt;activa[c] 1 = falta leer muestras&lt;br&gt;pend[c] &amp;nbsp;&amp;nbsp;1 = falta que suene la cola&lt;br&gt;marca[c] &amp;nbsp;valor de escritas al terminar&lt;br&gt;fin[c] &amp;nbsp;&amp;nbsp;&amp;nbsp;1 = el WAV terminó de sonar&lt;br&gt;&lt;span style=&quot;font-family: Inter, Helvetica, Arial, sans-serif; font-size: 11px; color: #444444; font-weight: normal; font-style: normal;&quot;&gt;Globales: audio_ok, en_sw, nclips,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family: Inter, Helvetica, Arial, sans-serif; font-size: 11px; color: #444444; font-weight: normal; font-style: normal;&quot;&gt;escritas, err_unf, err_ovf&lt;/span&gt;" vertex="1">
          <mxGeometry height="206" width="302" x="1264" y="769" as="geometry" />
        </mxCell>
        <mxCell id="c84" parent="1" style="shape=note;size=10;backgroundOutline=1;html=1;whiteSpace=nowrap;fillColor=#fffbe3;strokeColor=#b9a24a;strokeWidth=1.3;verticalAlign=middle;align=left;spacingLeft=12;spacing=0;spacingTop=0;spacingBottom=0;spacingRight=0;fontFamily=Inter,Helvetica,Arial,sans-serif;fontSize=11;fontColor=#444444;fontStyle=0;" value="&lt;span style=&quot;font-family: Inter, Helvetica, Arial, sans-serif; font-size: 11px; color: #333333; font-weight: bold; font-style: normal;&quot;&gt;CONVENCIONES&lt;/span&gt;&lt;br&gt;Texto azul: acceso a un registro por el bus&lt;br&gt;(escritura sw / lectura lw).&lt;br&gt;Texto verde: señal de terminación.&lt;br&gt;Terminal rojo: salida con código de error.&lt;br&gt;Caja con doble borde: subproceso (Hoja 3).&lt;br&gt;x[a:b]: bytes a…b de un búfer, little-endian." vertex="1">
          <mxGeometry height="117" width="302" x="1264" y="995" as="geometry" />
