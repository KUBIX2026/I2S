        <mxCell id="c76" parent="1" style="shape=note;size=10;backgroundOutline=1;html=1;whiteSpace=nowrap;fillColor=#fffbe3;strokeColor=#b9a24a;strokeWidth=1.3;verticalAlign=middle;align=left;spacingLeft=12;spacing=0;spacingTop=0;spacingBottom=0;spacingRight=0;fontFamily=Inter,Helvetica,Arial,sans-serif;fontSize=11;fontColor=#444444;fontStyle=0;" value="Resultado de cada flash_leer (no se dibuja en cada llamada):&lt;br&gt;OCUPADA ⇒ termina con ERR_OCUPADA (el juego puede reintentar)&lt;br&gt;FALLA &amp;nbsp;&amp;nbsp;⇒ termina con ERR_FLASH y audio_ok ← 0&lt;br&gt;Con cualquier error el canal c no se modifica:&lt;br&gt;lo que estaba sonando sigue igual." vertex="1">
          <mxGeometry height="88" width="379" x="359" y="1921" as="geometry" />
        </mxCell>
        <mxCell id="c77" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=31;html=1;whiteSpace=nowrap;fillColor=#e9e9e9;strokeColor=#5c5c5c;strokeWidth=1.3;verticalAlign=middle;align=center;spacingLeft=0;spacing=0;spacingTop=0;spacingBottom=0;spacingRight=0;fontFamily=Inter,Helvetica,Arial,sans-serif;fontSize=13;fontColor=#111111;fontStyle=1;" value="audio_stop(c)" vertex="1">
