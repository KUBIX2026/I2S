          <mxGeometry height="49" width="138" x="881" y="1367" as="geometry" />
        </mxCell>
        <mxCell id="c57" parent="1" style="rounded=0;html=1;whiteSpace=nowrap;fillColor=#ffffff;strokeColor=#222222;strokeWidth=1.3;verticalAlign=middle;align=center;spacingLeft=0;spacing=0;spacingTop=0;spacingBottom=0;spacingRight=0;fontFamily=Inter,Helvetica,Arial,sans-serif;fontSize=11;fontColor=#444444;fontStyle=0;" value="&lt;span style=&quot;font-family: Inter, Helvetica, Arial, sans-serif; font-size: 13px; color: #111111; font-weight: bold; font-style: normal;&quot;&gt;spi_flash_ctrl&lt;/span&gt;&lt;br&gt;atiende cada lectura de la CPU:&lt;br&gt;&lt;span style=&quot;font-family: &#39;DejaVu Sans Mono&#39;, &#39;JetBrains Mono&#39;, Consolas, monospace; font-size: 11px; color: #333333; font-weight: normal; font-style: normal;&quot;&gt;DIR_INI, DIR_FIN, LEC&lt;/span&gt;&lt;br&gt;→ SPI: 03h + dirección (24 bits)&lt;br&gt;→ arma paquetes de 32 bits&lt;br&gt;→ pausa sclk hasta que la&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;CPU lea DATO" vertex="1">
          <mxGeometry height="636" width="190" x="365" y="635" as="geometry" />
        </mxCell>
        <mxCell id="c58" parent="1" style="rounded=0;html=1;whiteSpace=nowrap;fillColor=#ffffff;strokeColor=#222222;strokeWidth=1.3;verticalAlign=middle;align=center;spacingLeft=0;spacing=0;spacingTop=0;spacingBottom=0;spacingRight=0;fontFamily=Inter,Helvetica,Arial,sans-serif;fontSize=13;fontColor=#111111;fontStyle=1;" value="Interfaz CSR&lt;br&gt;&lt;span style=&quot;font-family: &#39;DejaVu Sans Mono&#39;, &#39;JetBrains Mono&#39;, Consolas, monospace; font-size: 12px; color: #111111; font-weight: normal; font-style: normal;&quot;&gt;DATA ← u &amp;nbsp;⇒ &amp;nbsp;push&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family: &#39;DejaVu Sans Mono&#39;, &#39;JetBrains Mono&#39;, Consolas, monospace; font-size: 11px; color: #333333; font-weight: normal; font-style: normal;&quot;&gt;FULL ⇒ OVERFLOW ← 1&lt;/span&gt;" vertex="1">
          <mxGeometry height="62" width="150" x="1180" y="1176" as="geometry" />
        </mxCell>
        <mxCell id="c59" parent="1" style="shape=cylinder3;size=7;lid=1;backgroundOutline=1;html=1;whiteSpace=nowrap;fillColor=#eef3f7;strokeColor=#3d5466;strokeWidth=1.3;verticalAlign=middle;align=center;spacingLeft=0;spacing=0;spacingTop=0;spacingBottom=0;spacingRight=0;fontFamily=Inter,Helvetica,Arial,sans-serif;fontSize=13;fontColor=#111111;fontStyle=1;" value="FIFO 1024 × 8&lt;br&gt;&lt;span style=&quot;font-family: Inter, Helvetica, Arial, sans-serif; font-size: 11px; color: #444444; font-weight: normal; font-style: normal;&quot;&gt;≈ 23 ms de audio&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="114" x="1198" y="1268" as="geometry" />
        </mxCell>
        <mxCell id="c60" parent="1" style="rounded=0;html=1;whiteSpace=nowrap;fillColor=#ffffff;strokeColor=#222222;strokeWidth=1.3;verticalAlign=middle;align=center;spacingLeft=0;spacing=0;spacingTop=0;spacingBottom=0;spacingRight=0;fontFamily=DejaVu Sans Mono,JetBrains Mono,Consolas,monospace;fontSize=12;fontColor=#111111;fontStyle=0;" value="&lt;span style=&quot;font-family: Inter, Helvetica, Arial, sans-serif; font-size: 13px; color: #111111; font-weight: bold; font-style: normal;&quot;&gt;Transmisor (cada 1/FS_REAL)&lt;/span&gt;&lt;br&gt;pop → s = u − 128&lt;br&gt;trama de 32 BCLK: L = R = s&lt;br&gt;&lt;span style=&quot;font-family: &#39;DejaVu Sans Mono&#39;, &#39;JetBrains Mono&#39;, Consolas, monospace; font-size: 11px; color: #333333; font-weight: normal; font-style: normal;&quot;&gt;FIFO vacía ⇒ silencio y&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family: &#39;DejaVu Sans Mono&#39;, &#39;JetBrains Mono&#39;, Consolas, monospace; font-size: 11px; color: #333333; font-weight: normal; font-style: normal;&quot;&gt;UNDERFLOW ← 1&lt;/span&gt;" vertex="1">
          <mxGeometry height="93" width="218" x="1146" y="1358" as="geometry" />
        </mxCell>
        <mxCell id="c61" parent="1" style="rounded=0;html=1;whiteSpace=nowrap;fillColor=#ffffff;strokeColor=#222222;strokeWidth=1.3;verticalAlign=middle;align=center;spacingLeft=0;spacing=0;spacingTop=0;spacingBottom=0;spacingRight=0;fontFamily=Inter,Helvetica,Arial,sans-serif;fontSize=11;fontColor=#444444;fontStyle=0;" value="&lt;span style=&quot;font-family: Inter, Helvetica, Arial, sans-serif; font-size: 13px; color: #111111; font-weight: bold; font-style: normal;&quot;&gt;MAX98357A&lt;/span&gt;&lt;br&gt;lee SD en ↑BCLK&lt;br&gt;LRCLK elige L / R&lt;br&gt;salida (L + R)/2 = s" vertex="1">
          <mxGeometry height="75" width="122" x="1554" y="1367" as="geometry" />
        </mxCell>
        <mxCell id="c62" parent="1" style="rounded=0;html=1;whiteSpace=nowrap;fillColor=#ffffff;strokeColor=#222222;strokeWidth=1.3;verticalAlign=middle;align=center;spacingLeft=0;spacing=0;spacingTop=0;spacingBottom=0;spacingRight=0;fontFamily=Inter,Helvetica,Arial,sans-serif;fontSize=13;fontColor=#111111;fontStyle=1;" value="DAC + clase D&lt;br&gt;&lt;span style=&quot;font-family: Inter, Helvetica, Arial, sans-serif; font-size: 11px; color: #444444; font-weight: normal; font-style: normal;&quot;&gt;ganancia 9 dB&lt;/span&gt;" vertex="1">
          <mxGeometry height="47" width="112" x="1559" y="1468" as="geometry" />
        </mxCell>
        <mxCell id="c63" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=31;html=1;whiteSpace=nowrap;fillColor=#e9e9e9;strokeColor=#5c5c5c;strokeWidth=1.3;verticalAlign=middle;align=center;spacingLeft=0;spacing=0;spacingTop=0;spacingBottom=0;spacingRight=0;fontFamily=Inter,Helvetica,Arial,sans-serif;fontSize=13;fontColor=#111111;fontStyle=1;" value="Parlante 4–8 Ω" vertex="1">
          <mxGeometry height="31" width="132" x="1549" y="1541" as="geometry" />
        </mxCell>
        <mxCell id="c64" parent="1" style="shape=note;size=10;backgroundOutline=1;html=1;whiteSpace=nowrap;fillColor=#fffbe3;strokeColor=#b9a24a;strokeWidth=1.3;verticalAlign=middle;align=left;spacingLeft=12;spacing=0;spacingTop=0;spacingBottom=0;spacingRight=0;fontFamily=Inter,Helvetica,Arial,sans-serif;fontSize=11;fontColor=#444444;fontStyle=0;" value="&lt;span style=&quot;font-family: Inter, Helvetica, Arial, sans-serif; font-size: 11px; color: #333333; font-weight: bold; font-style: normal;&quot;&gt;¿Cómo se sabe que terminó el WAV?&lt;/span&gt;&lt;br&gt;1. Fin de lectura: r[c] = 0. Ya se pidieron las N muestras&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;(N sale del chunk &quot;data&quot; del encabezado).&lt;br&gt;&lt;span style=&quot;font-family: &#39;DejaVu Sans Mono&#39;, &#39;JetBrains Mono&#39;, Consolas, monospace; font-size: 11px; color: #333333; font-weight: normal; font-style: normal;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;marca[c] ← escritas; &amp;nbsp;pend[c] ← 1&lt;/span&gt;&lt;br&gt;2. Fin de sonido: escritas − LEVEL ≥ marca[c]. La última&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;muestra ya salió de la FIFO.&lt;br&gt;&lt;span style=&quot;font-family: &#39;DejaVu Sans Mono&#39;, &#39;JetBrains Mono&#39;, Consolas, monospace; font-size: 12px; color: #1d6b33; font-weight: bold; font-style: normal;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;fin[c] ← 1 &amp;nbsp;(señal de terminación para el juego)&lt;/span&gt;&lt;br&gt;3. Sin canales activos y LEVEL = 0:&lt;br&gt;&lt;span style=&quot;font-family: &#39;DejaVu Sans Mono&#39;, &#39;JetBrains Mono&#39;, Consolas, monospace; font-size: 12px; color: #1f5fa8; font-weight: normal; font-style: normal;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;CONTROL ← 0 &amp;nbsp;(EN = 0)&lt;/span&gt;" vertex="1">
          <mxGeometry height="149" width="392" x="629" y="1642" as="geometry" />
        </mxCell>
        <mxCell id="c65" parent="1" style="rounded=0;html=1;whiteSpace=nowrap;fillColor=#ffffff;strokeColor=#222222;strokeWidth=1.3;verticalAlign=middle;align=center;spacingLeft=0;spacing=0;spacingTop=0;spacingBottom=0;spacingRight=0;fontFamily=Inter,Helvetica,Arial,sans-serif;fontSize=11;fontColor=#444444;fontStyle=0;" value="&lt;span style=&quot;font-family: &#39;DejaVu Sans Mono&#39;, &#39;JetBrains Mono&#39;, Consolas, monospace; font-size: 12px; color: #111111; font-weight: normal; font-style: normal;&quot;&gt;en = 0&lt;/span&gt;&lt;br&gt;la trama en curso termina;&lt;br&gt;run ← 0: BCLK y LRCLK se&lt;br&gt;detienen juntos" vertex="1">
          <mxGeometry height="75" width="162" x="1174" y="1679" as="geometry" />
        </mxCell>
        <mxCell id="c66" parent="1" style="rounded=0;html=1;whiteSpace=nowrap;fillColor=#ffffff;strokeColor=#222222;strokeWidth=1.3;verticalAlign=middle;align=center;spacingLeft=0;spacing=0;spacingTop=0;spacingBottom=0;spacingRight=0;fontFamily=Inter,Helvetica,Arial,sans-serif;fontSize=11;fontColor=#444444;fontStyle=0;" value="&lt;span style=&quot;font-family: Inter, Helvetica, Arial, sans-serif; font-size: 13px; color: #111111; font-weight: bold; font-style: normal;&quot;&gt;Sin BCLK:&lt;/span&gt;&lt;br&gt;el MAX98357A entra&lt;br&gt;en reposo" vertex="1">
          <mxGeometry height="61" width="130" x="1550" y="1686" as="geometry" />
        </mxCell>
        <mxCell id="c67" parent="1" style="shape=note;size=10;backgroundOutline=1;html=1;whiteSpace=nowrap;fillColor=#fffbe3;strokeColor=#b9a24a;strokeWidth=1.3;verticalAlign=middle;align=left;spacingLeft=12;spacing=0;spacingTop=0;spacingBottom=0;spacingRight=0;fontFamily=Inter,Helvetica,Arial,sans-serif;fontSize=11;fontColor=#444444;fontStyle=0;" value="Ventaja de separar 1 y 2: la FIFO&lt;br&gt;retrasa el sonido hasta ≈ 23 ms; el&lt;br&gt;juego sabe cuándo el WAV de verdad&lt;br&gt;dejó de oírse, no solo cuándo se leyó." vertex="1">
          <mxGeometry height="73" width="220" x="350" y="1680" as="geometry" />
        </mxCell>
        <mxCell id="c68" parent="1" style="text;html=1;align=left;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;spacingRight=0;spacingLeft=0;strokeColor=none;fillColor=none;fontFamily=Inter,Helvetica,Arial,sans-serif;fontSize=24;fontColor=#111111;fontStyle=1;" value="&lt;div&gt;Flujo general del audio: del archivo WAV al parlante&lt;/div&gt;" vertex="1">
          <mxGeometry height="32" width="774" x="28" y="38" as="geometry" />
        </mxCell>
        <mxCell id="c69" parent="1" style="text;html=1;align=left;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;spacingRight=0;spacingLeft=0;strokeColor=none;fillColor=none;fontFamily=Inter,Helvetica,Arial,sans-serif;fontSize=13;fontColor=#444444;fontStyle=0;" value="Diagrama de carriles: cada columna es un responsable. Flechas negras: control. Flechas azules discontinuas: datos por el bus. Flecha verde azulada: señal de audio." vertex="1">
