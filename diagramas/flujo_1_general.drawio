        <mxCell id="c54" parent="1" style="shape=process;fixedSize=1;size=8;backgroundOutline=1;html=1;whiteSpace=nowrap;fillColor=#f3f7ff;strokeColor=#222222;strokeWidth=1.3;verticalAlign=middle;align=center;spacingLeft=0;spacing=0;spacingTop=0;spacingBottom=0;spacingRight=0;fontFamily=DejaVu Sans Mono,JetBrains Mono,Consolas,monospace;fontSize=12;fontColor=#111111;fontStyle=0;" value="&lt;span style=&quot;font-family: &#39;DejaVu Sans Mono&#39;, &#39;JetBrains Mono&#39;, Consolas, monospace; font-size: 12px; color: #111111; font-weight: bold; font-style: normal;&quot;&gt;audio_service()&lt;/span&gt;&lt;br&gt;libres = 1024 − LEVEL&lt;br&gt;q = min(libres, r[c])&lt;br&gt;flash_leer(dir[c], q, DATA)&lt;br&gt;&lt;span style=&quot;font-family: Inter, Helvetica, Arial, sans-serif; font-size: 11px; color: #444444; font-weight: normal; font-style: normal;&quot;&gt;Hoja 3&lt;/span&gt;" vertex="1">
