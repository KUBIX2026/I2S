        <mxCell id="c55" parent="1" style="shape=note;size=10;backgroundOutline=1;html=1;whiteSpace=nowrap;fillColor=#f5f5f5;strokeColor=#8a8a8a;strokeWidth=1.3;verticalAlign=middle;align=left;spacingLeft=12;spacing=0;spacingTop=0;spacingBottom=0;spacingRight=0;fontFamily=DejaVu Sans Mono,JetBrains Mono,Consolas,monospace;fontSize=11;fontColor=#333333;fontStyle=0;" value="&lt;span style=&quot;font-family: Inter, Helvetica, Arial, sans-serif; font-size: 11px; color: #333333; font-weight: bold; font-style: normal;&quot;&gt;CÓMO SE SABE DÓNDE TERMINA&lt;/span&gt;&lt;br&gt;Salto entre chunks: &amp;nbsp;p_k+1 = p_k + 8 + SZ_k + (SZ_k mod 2)&lt;br&gt;Muestras del WAV: &amp;nbsp;&amp;nbsp;&amp;nbsp;N = min(D, fin_arch − p_datos)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(B = nBlockAlign = 1 byte por muestra)&lt;br&gt;Duración: &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;T = N / FS_AUDIO&lt;br&gt;Fin de lectura: &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;r[c] = 0 &amp;nbsp;&amp;nbsp;(r[c] arranca en N y baja con cada q)&lt;br&gt;Fin de sonido: &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;escritas − LEVEL ≥ marca[c] &amp;nbsp;⇒ &amp;nbsp;fin[c] ← 1&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-family: Inter, Helvetica, Arial, sans-serif; font-size: 11px; color: #444444; font-weight: normal; font-style: normal;&quot;&gt;El min() protege de un archivo truncado o de un D = 0xFFFFFFFF.&lt;/span&gt;" vertex="1">
          <mxGeometry height="147" width="481" x="890" y="568" as="geometry" />
        </mxCell>
        <mxCell id="c56" parent="1" style="shape=note;size=10;backgroundOutline=1;html=1;whiteSpace=nowrap;fillColor=#fffbe3;strokeColor=#b9a24a;strokeWidth=1.3;verticalAlign=middle;align=left;spacingLeft=12;spacing=0;spacingTop=0;spacingBottom=0;spacingRight=0;fontFamily=DejaVu Sans Mono,JetBrains Mono,Consolas,monospace;fontSize=11;fontColor=#333333;fontStyle=0;" value="&lt;span style=&quot;font-family: Inter, Helvetica, Arial, sans-serif; font-size: 11px; color: #333333; font-weight: bold; font-style: normal;&quot;&gt;EJEMPLOS REALES (I2S_Sonidos_8bits)&lt;/span&gt;&lt;br&gt;dispara_8bit_mono.wav&lt;br&gt;&amp;nbsp;&amp;nbsp;TAM = 23 858 B · p_datos = p + 44 · D = 23 814&lt;br&gt;&amp;nbsp;&amp;nbsp;N = 23 814 muestras · T = 0.540 s&lt;br&gt;AlienPurr7_8bit_mono.wav&lt;br&gt;&amp;nbsp;&amp;nbsp;D = 93 863 (impar) y sin byte de relleno:&lt;br&gt;&amp;nbsp;&amp;nbsp;N = min(93 863, 93 907 − 44) = 93 863 · T = 2.13 s&lt;br&gt;musuca_1_8bit_mono.wav (la más larga)&lt;br&gt;&amp;nbsp;&amp;nbsp;D = 3 293 228 · T = 74.7 s&lt;br&gt;Total: 18 WAV = 10 659 129 B + 152 B de directorio" vertex="1">
