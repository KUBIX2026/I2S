        </mxCell>
        <mxCell id="c98" parent="1" style="shape=trapezoid;perimeter=trapezoidPerimeter;fixedSize=1;size=24;direction=north;fillColor=#ffffff;strokeColor=#222222;strokeWidth=1.4;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;spacingRight=0;spacingLeft=0;fontFamily=Inter,Helvetica,Arial,sans-serif;fontSize=13;fontColor=#111111;fontStyle=0;" value="" vertex="1">
          <mxGeometry height="96" width="26" x="1788" y="572" as="geometry" />
        </mxCell>
        <mxCell id="c99" parent="1" style="shape=note;size=10;backgroundOutline=1;html=1;whiteSpace=nowrap;fillColor=#fffbe3;strokeColor=#b9a24a;strokeWidth=1.3;verticalAlign=middle;align=left;spacingLeft=12;spacing=0;spacingTop=0;spacingBottom=0;spacingRight=0;fontFamily=Inter,Helvetica,Arial,sans-serif;fontSize=11;fontColor=#444444;fontStyle=0;" value="&lt;span style=&quot;font-family: Inter, Helvetica, Arial, sans-serif; font-size: 11px; color: #333333; font-weight: bold; font-style: normal;&quot;&gt;CAMINO DE UNA MUESTRA&lt;/span&gt;&lt;br&gt;① Flash → spi_flash_ctrl: lectura SPI 03h, un byte&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;por cada 8 flancos de sclk (pin DO → miso).&lt;br&gt;② spi_flash_ctrl → CPU: lw de DATO = 4 muestras por&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;d_out → mux → mem_rdata.&lt;br&gt;③ CPU → perip_i2s: sw de DATA (mem_wdata[7:0]),&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;una muestra u8 por escritura → push en la FIFO.&lt;br&gt;④ FIFO → transmisor: un pop por trama (1/FS_REAL).&lt;br&gt;⑤ perip_i2s → MAX98357A: BCLK = 32·FS_REAL,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;LRCLK = FS_REAL, SD = muestra, MSB primero.&lt;br&gt;⑥ MAX98357A → parlante: PWM clase D, ≤ 3.2 W en 4 Ω.&lt;br&gt;&lt;br&gt;Tasa de audio: FS_REAL muestras/s ≈ 43–44 kB/s&lt;br&gt;(1 byte por muestra, mono). La FIFO guarda&lt;br&gt;1024 muestras ≈ 23 ms." vertex="1">
          <mxGeometry height="235" width="330" x="1475" y="810" as="geometry" />
        </mxCell>
        <mxCell id="c100" parent="1" style="shape=note;size=10;backgroundOutline=1;html=1;whiteSpace=nowrap;fillColor=#f5f5f5;strokeColor=#8a8a8a;strokeWidth=1.3;verticalAlign=middle;align=left;spacingLeft=12;spacing=0;spacingTop=0;spacingBottom=0;spacingRight=0;fontFamily=DejaVu Sans Mono,JetBrains Mono,Consolas,monospace;fontSize=11;fontColor=#333333;fontStyle=0;" value="&lt;span style=&quot;font-family: Inter, Helvetica, Arial, sans-serif; font-size: 11px; color: #333333; font-weight: bold; font-style: normal;&quot;&gt;PARÁMETROS&lt;/span&gt;&lt;br&gt;FCIA_FPGA = frecuencia de clk (por definir)&lt;br&gt;FS_AUDIO &amp;nbsp;= 44 100 Hz&lt;br&gt;DIV &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;= (FCIA_FPGA + 16·FS_AUDIO) / (32·FS_AUDIO)&lt;br&gt;FS_REAL &amp;nbsp;&amp;nbsp;= FCIA_FPGA / (32·DIV)&lt;br&gt;PROF_FIFO = 1024" vertex="1">
          <mxGeometry height="102" width="375" x="360" y="985" as="geometry" />
        </mxCell>
        <mxCell id="c101" parent="1" style="text;html=1;align=left;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;spacingRight=0;spacingLeft=0;strokeColor=none;fillColor=none;fontFamily=Inter,Helvetica,Arial,sans-serif;fontSize=24;fontColor=#111111;fontStyle=1;" value="Sistema: dónde está cada pieza y por dónde viaja el audio" vertex="1">
          <mxGeometry height="32" width="894" x="28" y="38" as="geometry" />
        </mxCell>
        <mxCell id="c102" parent="1" style="text;html=1;align=left;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;spacingRight=0;spacingLeft=0;strokeColor=none;fillColor=none;fontFamily=Inter,Helvetica,Arial,sans-serif;fontSize=13;fontColor=#444444;fontStyle=0;" value="SoC del curso (femtoRV32 + bus CSR) con la flash externa del grupo D, el periférico perip_i2s del grupo I y el MAX98357A. Los números ①–⑥ siguen el camino de una muestra." vertex="1">
          <mxGeometry height="17" width="1094" x="28" y="66" as="geometry" />
        </mxCell>
