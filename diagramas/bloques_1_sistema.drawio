        <mxCell id="c97" parent="1" style="rounded=0;fillColor=#ffffff;strokeColor=#222222;strokeWidth=1.4;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingBottom=0;spacingRight=0;spacingLeft=0;fontFamily=Inter,Helvetica,Arial,sans-serif;fontSize=13;fontColor=#111111;fontStyle=0;" value="" vertex="1">
